{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Examples: Run build-plugin example",
            "type": "process",
            "command": "swift",
            "args": [
                "run",
                "--package-path",
                "Examples/PluginExample",
                "PluginExample"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "detail": "Builds generated schemas with the SwiftPM plugin and parses the example fixtures.",
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            }
        }
    ]
}
